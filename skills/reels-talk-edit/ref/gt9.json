 "captions": [
  {
   "text": "끝난다더니 또 공격했다던데?",
   "speaker": "geonho",
   "out_start": 2.833,
   "out_end": 5.067,
   "src_start": 6.678,
   "src_end": 9.106
  },
  {
   "text": "아 트럼프형?",
   "speaker": "jungwoo",
   "out_start": 5.067,
   "out_end": 6.233,
   "src_start": 9.128,
   "src_end": 10.389
  },
  {
   "text": "전쟁이 끝나려면",
   "speaker": "jungwoo",
   "out_start": 6.233,
   "out_end": 7.767,
   "src_start": 11.811,
   "src_end": 13.476
  },
  {
   "text": "서로 받아들일 조건이 맞아야 돼",
   "speaker": "jungwoo",
   "out_start": 7.767,
   "out_end": 10.033,
   "src_start": 14.111,
   "src_end": 16.582
  },
  {
   "text": "미국이 내세운 명분은",
   "speaker": "jungwoo",
   "out_start": 10.033,
   "out_end": 12.2,
   "src_start": 17.244,
   "src_end": 19.606
  },
  {
   "text": "이란 핵 문제고",
   "speaker": "jungwoo",
   "out_start": 12.2,
   "out_end": 13.4,
   "src_start": 19.628,
   "src_end": 20.926
  },
  {
   "text": "공격 멈춘다고",
   "speaker": "jungwoo",
   "out_start": 13.4,
   "out_end": 15.2,
   "src_start": 23.978,
   "src_end": 26.982
  },
  {
   "text": "그게 해결되는 건 아니잖아",
   "speaker": "jungwoo",
   "out_start": 15.2,
   "out_end": 16.267,
   "src_start": 27.004,
   "src_end": 28.156
  },
  {
   "text": "\"그냥 그만 싸우자\"",
   "speaker": "geonho",
   "out_start": 16.267,
   "out_end": 17.567,
   "src_start": 29.944,
   "src_end": 31.352
  },
  {
   "text": "해서 끝날 일이 아니구나",
   "speaker": "geonho",
   "out_start": 17.567,
   "out_end": 19.167,
   "src_start": 31.374,
   "src_end": 33.112
  },
  {
   "text": "제일 중요하게 봐야 되는 건",
   "speaker": "jungwoo",
   "out_start": 19.167,
   "out_end": 21.6,
   "src_start": 34.311,
   "src_end": 36.966
  },
  {
   "text": "호르무즈 해협이야",
   "speaker": "jungwoo",
   "out_start": 21.6,
   "out_end": 22.633,
   "src_start": 36.988,
   "src_end": 38.102
  },
  {
   "text": "중동에서 기름 실은 배가",
   "speaker": "jungwoo",
   "out_start": 22.633,
   "out_end": 24.7,
   "src_start": 38.744,
   "src_end": 40.996
  },
  {
   "text": "나오는 길이거든",
   "speaker": "jungwoo",
   "out_start": 24.7,
   "out_end": 26.767,
   "src_start": 41.478,
   "src_end": 43.729
  },
  {
   "text": "이겼다고 말하는 거랑",
   "speaker": "jungwoo",
   "out_start": 26.767,
   "out_end": 28.4,
   "src_start": 44.778,
   "src_end": 46.552
  },
  {
   "text": "배가 안전하게 다니는 건 다른 문제야",
   "speaker": "jungwoo",
   "out_start": 28.4,
   "out_end": 32.7,
   "src_start": 46.574,
   "src_end": 52.562
  },
  {
   "text": "국제에너지기구도 9월 원유 흐름이",
   "speaker": "jungwoo",
   "out_start": 32.7,
   "out_end": 36.967,
   "src_start": 54.347,
   "src_end": 60.293
  },
  {
   "text": "아직 전쟁 전 수준에 못 미친다고 했어",
   "speaker": "jungwoo",
   "out_start": 36.967,
   "out_end": 38.9,
   "src_start": 60.714,
   "src_end": 63.393
  },
  {
   "text": "60% 정도?",
   "speaker": "jungwoo",
   "out_start": 38.9,
   "out_end": 39.767,
   "src_start": 63.811,
   "src_end": 64.742
  },
  {
   "text": "미국 해사청도",
   "speaker": "jungwoo",
   "out_start": 39.767,
   "out_end": 41.1,
   "src_start": 65.113,
   "src_end": 66.82
  },
  {
   "text": "상선 공격 위험이 높다고 경고했고",
   "speaker": "jungwoo",
   "out_start": 41.1,
   "out_end": 42.633,
   "src_start": 66.846,
   "src_end": 68.814
  },
  {
   "text": "그래서 기름값이 계속 오르는거지?",
   "speaker": "geonho",
   "out_start": 42.633,
   "out_end": 45.333,
   "src_start": 70.344,
   "src_end": 73.292
  },
  {
   "text": "그치그치",
   "speaker": "jungwoo",
   "out_start": 44.5,
   "out_end": 45.333,
   "src_start": 72.398,
   "src_end": 73.292
  },
  {
   "text": "공급이 막히면 당연히 기름값이 오르고",
   "speaker": "jungwoo",
   "out_start": 45.333,
   "out_end": 48.4,
   "src_start": 73.744,
   "src_end": 77.096
  },
  {
   "text": "비행기 띄우고",
   "speaker": "jungwoo",
   "out_start": 48.4,
   "out_end": 49.367,
   "src_start": 77.478,
   "src_end": 78.519
  },
  {
   "text": "물건 나르는 비용도 커지겠지",
   "speaker": "jungwoo",
   "out_start": 49.367,
   "out_end": 52.3,
   "src_start": 78.541,
   "src_end": 81.746
  },
  {
   "text": "그게 우리 생활비까지",
   "speaker": "jungwoo",
   "out_start": 52.3,
   "out_end": 53.7,
   "src_start": 82.178,
   "src_end": 83.696
  },
  {
   "text": "이어질 수 있다는 거야",
   "speaker": "jungwoo",
   "out_start": 53.7,
   "out_end": 54.733,
   "src_start": 83.718,
   "src_end": 84.832
  },
  {
   "text": "기름값 오르면",
   "speaker": "geonho",
   "out_start": 54.733,
   "out_end": 56.3,
   "src_start": 85.911,
   "src_end": 87.612
  },
  {
   "text": "주유비 오르는 건 알겠는데",
   "speaker": "geonho",
   "out_start": 56.3,
   "out_end": 57.867,
   "src_start": 87.634,
   "src_end": 89.596
  },
  {
   "text": "생활비까지 왜?",
   "speaker": "geonho",
   "out_start": 57.867,
   "out_end": 59.133,
   "src_start": 89.618,
   "src_end": 90.989
  },
  {
   "text": "국제유가가 오르면",
   "speaker": "jungwoo",
   "out_start": 59.133,
   "out_end": 61.6,
   "src_start": 91.847,
   "src_end": 95.273
  },
  {
   "text": "자동차 주유비만 오르는 게 아니야",
   "speaker": "jungwoo",
   "out_start": 61.6,
   "out_end": 63.233,
   "src_start": 95.301,
   "src_end": 97.559
  },
  {
   "text": "한전이랑 가스공사는",
   "speaker": "jungwoo",
   "out_start": 63.233,
   "out_end": 65.167,
   "src_start": 97.587,
   "src_end": 100.266
  },
  {
   "text": "연료비 연동제라는 게 있어서",
   "speaker": "jungwoo",
   "out_start": 65.167,
   "out_end": 68.1,
   "src_start": 100.294,
   "src_end": 104.373
  },
  {
   "text": "전기, 가스 요금도 올라가",
   "speaker": "jungwoo",
   "out_start": 68.1,
   "out_end": 69.833,
   "src_start": 104.401,
   "src_end": 106.799
  },
  {
   "text": "배송비도 오르고",
   "speaker": "jungwoo",
   "out_start": 69.833,
   "out_end": 71.567,
   "src_start": 106.827,
   "src_end": 109.226
  },
  {
   "text": "내가 시키는 택배랑",
   "speaker": "jungwoo",
   "out_start": 71.567,
   "out_end": 72.833,
   "src_start": 109.254,
   "src_end": 110.999
  },
  {
   "text": "생필품 값도 따라 오를 수 있어",
   "speaker": "jungwoo",
   "out_start": 72.833,
   "out_end": 75.7,
   "src_start": 111.027,
   "src_end": 115.013
  },
  {
   "text": "그래서 뉴스 볼 때",
   "speaker": "jungwoo",
   "out_start": 75.7,
   "out_end": 78.667,
   "src_start": 124.344,
   "src_end": 130.406
  },
  {
   "text": "종전한다는 말만 듣고 끝내면 안 돼",
   "speaker": "jungwoo",
   "out_start": 78.667,
   "out_end": 80.833,
   "src_start": 130.844,
   "src_end": 133.815
  },
  {
   "text": "실제로 합의가 지켜지는지",
   "speaker": "jungwoo",
   "out_start": 80.833,
   "out_end": 82.8,
   "src_start": 133.839,
   "src_end": 136.175
  },
  {
   "text": "배가 해협을 다시 지나다니는지",
   "speaker": "jungwoo",
   "out_start": 82.8,
   "out_end": 85.133,
   "src_start": 136.199,
   "src_end": 138.975
  },
  {
   "text": "원유 공급이 얼마나 회복되는지",
   "speaker": "jungwoo",
   "out_start": 85.133,
   "out_end": 87.4,
   "src_start": 138.999,
   "src_end": 141.695
  },
  {
   "text": "같이 봐야 돼",
   "speaker": "jungwoo",
   "out_start": 87.4,
   "out_end": 88.333,
   "src_start": 141.719,
   "src_end": 142.815
  }
 ],
